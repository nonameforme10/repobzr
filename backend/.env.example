# Server Configuration
PORT=5000
NODE_ENV=production

# Comma-separated allowed frontend origins (no trailing slashes)
# In production, specify your Vercel frontend URL & custom domains:
CORS_ORIGIN=https://caretrack.website,https://www.caretrack.website,https://project-7gjuu.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# Cache TTLs in milliseconds
RATES_CACHE_TTL_MS=3600000
HISTORY_CACHE_TTL_MS=86400000

# Upstream CBU request timeout in milliseconds
FETCH_TIMEOUT_MS=8000

# PostgreSQL 16 Connection (Localhost only)
DATABASE_URL=postgres://bozor_user:YOUR_PASSWORD@127.0.0.1:5432/bozor_db

# ImageKit Storage Configuration
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# AI Multilingual Translation & Typo Correction
OPENROUTER_API_KEY5=sk-or-v1-...
AI_STUDIO_API_KEY1=AQ.Ab8...

# Telegram Bot Configuration (Python / aiogram 3)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_DAILY_REPORT_ENABLED=true
TELEGRAM_DAILY_REPORT_TIME=21:00
TELEGRAM_REPORT_CHAT_IDS=123456789
